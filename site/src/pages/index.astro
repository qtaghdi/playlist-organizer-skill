---
import gemDocument from '../../../integrations/gemini-gem.md?raw';
import demo from '../listening-demo.json';
import HostPicker from '../components/host-picker.astro';
import '../site.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const repo = 'https://github.com/qtaghdi/playlist-organizer-skill';
const zip = `${repo}/releases/latest/download/playlist-organizer.zip`;
const docs = `${repo}/blob/main/skills/playlist-organizer/references`;
const gemInstructions = gemDocument.split('\n---\n')[1].trim();
const codexRequest = `Use $skill-installer to install Playlist Organizer from ${repo}/tree/main/skills/playlist-organizer`;
const geminiRequest = `Create a skill named Playlist Organizer based on these instructions:\n\n${gemInstructions}`;
const command = (agent: string) =>
  `npx --yes skills add qtaghdi/playlist-organizer-skill --skill playlist-organizer -a ${agent} -g -y`;
const hosts = [
  { name: 'Codex', agent: 'codex', invocation: '$playlist-organizer' },
  { name: 'Claude Code', agent: 'claude-code', invocation: '/playlist-organizer' },
  { name: 'Gemini CLI', agent: 'gemini-cli', invocation: '' },
  { name: 'GitHub Copilot', agent: 'github-copilot', invocation: '' },
  { name: 'Cursor', agent: 'cursor', invocation: '' },
  { name: 'OpenCode', agent: 'opencode', invocation: '@playlist-organizer' },
];
const hostOptions = [
  hosts[0],
  { name: 'Claude web and desktop', agent: 'claude' },
  hosts[1],
  { name: 'Gemini web', agent: 'gemini' },
  ...hosts.slice(2),
];
const inputs = [
  { name: 'Apple Music', file: 'Music XML', ref: 'apple-music' },
  { name: 'Spotify', file: 'Account Data JSON', ref: 'spotify' },
  { name: 'YouTube Music', file: 'Takeout CSV', ref: 'youtube-music' },
  { name: 'Other music apps', file: 'CSV or a track list', ref: 'portable-inputs' },
  { name: 'Local playlists', file: 'M3U or M3U8', ref: 'm3u' },
];
const trackNames = new Map(Object.entries(demo.tracks));
const position = (index: number) => String(index + 1).padStart(2, '0');
const from = position(demo.order.before.indexOf(demo.changedTrack));
const to = position(demo.order.after.indexOf(demo.changedTrack));
const samplePrompt = `Use Playlist Organizer to review ${demo.name}. Keep the current order unless this listening note asks for a change. Show me the revised order before editing anything.\n\n${demo.savedNote}`;
const description = 'An open-source AI skill for organizing playlists, comparing changes, and carrying listening notes into your next draft.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Playlist Organizer" />
    <meta property="og:description" content={description} />
    <title>Playlist Organizer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead wrap">
      <a class="brand" href={base}>
        <img src={`${base}mark.svg`} width="29" height="29" alt="" />
        <span>Playlist Organizer</span>
      </a>
      <nav aria-label="Main navigation">
        <a class="support-link" href="#support">Compatibility</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <h1 id="title">Keep the <em>good</em> transitions.</h1>
        <div class="hero-intro">
          <p>Reorder the playlists you already listen to. Leave a note about what works and carry it into the next draft.</p>
          <a class="button primary" href="#install">Install the skill</a>
        </div>

        <figure class="session" id="example" aria-labelledby="example-title">
          <figcaption class="session-note">
            <p id="example-title">Listening note</p>
            <blockquote>“{demo.note}”</blockquote>
            <p>{demo.name}</p>
          </figcaption>
          <div class="session-result">
            <div class="result-heading">
              <h2>Track order</h2>
              <div class="order-control" role="group" aria-label="Compare playlist order" hidden>
                <button type="button" data-order="before" aria-pressed="false">Before note</button>
                <button type="button" data-order="after" aria-pressed="true">After note</button>
              </div>
            </div>
            {(['after', 'before'] as const).map((state) => (
              <ol class="tracks" data-tracks={state} aria-label={state === 'after' ? 'After the note' : 'Before the note'} hidden={state === 'before'}>
                {demo.order[state].map((id, index) => (
                  <li class:list={[id === demo.changedTrack && (state === 'after' ? 'arrived' : 'original-position')]}>
                    <span class="position" aria-hidden="true">{position(index)}</span>
                    <span>{trackNames.get(id)?.title}</span>
                    {id === demo.changedTrack && (state === 'after' ? (
                      <span class="move"><span class="visually-hidden">Moved from track {Number(from)} to track {Number(to)}</span><span aria-hidden="true">{from} → {to}</span></span>
                    ) : (
                      <span class="move">Original position</span>
                    ))}
                  </li>
                ))}
              </ol>
            ))}
            <p class="session-caption">Recorded skill run with four fictional tracks.</p>
            <p class="visually-hidden" id="order-status" role="status"></p>
          </div>
        </figure>
      </section>

      <section class="setup wrap" id="install" aria-labelledby="install-title">
        <div class="section-heading">
          <h2 id="install-title">Install in your AI app.</h2>
          <p>Choose your app, then try the same playlist.</p>
        </div>
        <div class="setup-content">
          <HostPicker options={hostOptions} />

          {hosts.map(({ name, agent, invocation }) => (
            <div class="panel" data-setup={agent} hidden={agent !== 'codex'}>
              {agent === 'codex' ? (
                <>
                  <p>Copy this request and paste it into a Codex chat.</p>
                  <div class="install-actions">
                    <button type="button" class="button primary" data-copy data-copy-source="codex-request" data-feedback="Request copied. Paste it into Codex." hidden aria-label="Copy install request for Codex">Copy install request</button>
                  </div>
                  <details class="request-preview">
                    <summary>View install request</summary>
                    <pre><code id="codex-request">{codexRequest}</code></pre>
                  </details>
                  <details class="setup-alternative">
                    <summary>Install from a terminal</summary>
                    <p>Run with Node.js and npm.</p>
                    <div class="snippet">
                      <pre><code>{command(agent)}</code></pre>
                      <button type="button" data-copy hidden aria-label="Copy the Codex install command">Copy</button>
                    </div>
                  </details>
                </>
              ) : (
                <>
                  <p>Run in your terminal with Node.js and npm.</p>
                  <div class="snippet">
                    <pre><code>{command(agent)}</code></pre>
                    <button type="button" data-copy hidden aria-label={`Copy the ${name} install command`}>Copy</button>
                  </div>
                </>
              )}
              {invocation ? <p>Once installed, enter <code>{invocation}</code> in your AI app.</p> : <p>Once installed, ask your AI app to use Playlist Organizer.</p>}
            </div>
          ))}

          <div class="panel" data-setup="claude" hidden>
            <p>Download the skill ZIP. In Claude, open <strong>Plugins</strong> (or <strong>Customize → Skills</strong>) and upload it. Enable code execution if prompted.</p>
            <a class="button primary" href={zip}>Download skill ZIP</a>
            <a class="guide-link" href="https://support.claude.com/en/articles/12512180-use-skills-in-claude">Claude setup guide</a>
          </div>
          <div class="panel" data-setup="gemini" hidden>
            <p>Copy the request and paste it into a new Gemini chat to create the skill.</p>
            <div class="install-actions">
              <button type="button" class="button primary" data-copy data-copy-source="gemini-request" data-feedback="Request copied. Paste it into Gemini." hidden aria-label="Copy install request for Gemini">Copy install request</button>
              <a class="guide-link" href="https://gemini.google.com/">Open Gemini</a>
            </div>
            <details class="request-preview">
              <summary>View install request</summary>
              <pre><code id="gemini-request">{geminiRequest}</code></pre>
            </details>
            <details class="setup-alternative">
              <summary>Use Gems if Skills is unavailable</summary>
              <p>Create a Gem named <strong>Playlist Organizer</strong> and paste these instructions.</p>
              <div class="snippet">
                <textarea readonly rows="3" aria-label="Gemini Gem instructions">{gemInstructions}</textarea>
                <button type="button" data-copy hidden aria-label="Copy the Gemini Gem instructions">Copy</button>
              </div>
              <a class="guide-link" href="https://support.google.com/gemini/answer/15146780">Gemini Gems guide</a>
            </details>
          </div>
          <p id="install-copy-status" class="copy-status" role="status"></p>

          <a href={`${repo}#install`}>Manual installation</a>

          <div class="sample">
            <h3>Try the example</h3>
            <p><a href={`${base}sample-playlist.csv`} download>Download the sample CSV</a>, attach it in your AI app, and use this prompt.</p>
            <div class="snippet">
              <pre><code>{samplePrompt}</code></pre>
              <button type="button" data-copy hidden aria-label="Copy the sample prompt">Copy</button>
            </div>
            <p id="sample-copy-status" class="copy-status" role="status"></p>
          </div>
        </div>
      </section>

      <section class="support wrap" id="support" aria-labelledby="support-title">
        <div class="section-heading">
          <h2 id="support-title">Start with what you have.</h2>
          <p>Use an export or a track list to draft changes.</p>
        </div>
        <div class="support-content">
          <table>
            <caption class="visually-hidden">Music apps and supported input files</caption>
            <thead><tr><th scope="col">Music app</th><th scope="col">Input</th></tr></thead>
            <tbody>
              {inputs.map(({ name, file, ref }) => (
                <tr><th scope="row"><a href={`${docs}/${ref}.md`}>{name}</a></th><td>{file}</td></tr>
              ))}
            </tbody>
          </table>
          <p>Filtering by last play requires listening history. <a href={`${docs}/history.md`}>Add listening history</a></p>
          <p>Editing in a music app requires a supported connection and permission. Live edits in Spotify and YouTube Music are unverified.</p>
          <p><a href={`${docs}/feedback.md`}>Save and reuse listening notes</a></p>
          <p>The included file converters require Python 3.9 or later.</p>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <a class="brand" href={base}>
        <img src={`${base}mark.svg`} width="24" height="24" alt="" />
        <span>Playlist Organizer</span>
      </a>
      <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>
    </footer>

    <script>
      import demo from '../listening-demo.json';

      const orderControl = document.querySelector<HTMLElement>('.order-control')!;
      const orderButtons = orderControl.querySelectorAll<HTMLButtonElement>('[data-order]');
      const trackLists = document.querySelectorAll<HTMLOListElement>('[data-tracks]');
      const orderStatus = document.querySelector('#order-status')!;
      orderControl.hidden = false;

      orderButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.getAttribute('aria-pressed') === 'true') return;
          const state = button.dataset.order === 'before' ? 'before' : 'after';
          orderButtons.forEach((control) => {
            control.setAttribute('aria-pressed', String(control === button));
          });
          trackLists.forEach((list) => { list.hidden = list.dataset.tracks !== state; });
          const position = demo.order[state].indexOf(demo.changedTrack) + 1;
          orderStatus.textContent = `${button.textContent}: ${demo.tracks[demo.changedTrack as keyof typeof demo.tracks].title} is track ${position}.`;
        });
      });

      const picker = document.querySelector('#host-picker')!;
      const panels = document.querySelectorAll<HTMLElement>('[data-setup]');
      const installStatus = document.querySelector('#install-copy-status')!;
      const sampleStatus = document.querySelector('#sample-copy-status')!;
      picker.addEventListener('hostchange', (event) => {
        const { detail: agent } = event as CustomEvent<string>;
        panels.forEach((panel) => { panel.hidden = panel.dataset.setup !== agent; });
        installStatus.textContent = '';
      });

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', async () => {
          const snippet = button.closest('.snippet');
          const field = snippet?.querySelector('textarea');
          const code = button.dataset.copySource
            ? document.getElementById(button.dataset.copySource)
            : snippet?.querySelector('code');
          const value = field?.value ?? code?.textContent ?? '';
          const status = button.closest('.sample') ? sampleStatus : installStatus;
          try {
            await navigator.clipboard.writeText(value);
            if (button.closest<HTMLElement>('[data-setup]')?.hidden) return;
            status.textContent = button.dataset.feedback ?? 'Copied to clipboard.';
          } catch {
            if (button.closest<HTMLElement>('[data-setup]')?.hidden) return;
            if (field) {
              field.focus();
              field.select();
            } else if (code) {
              const preview = code.closest('details');
              if (preview) preview.open = true;
              const range = document.createRange();
              range.selectNodeContents(code);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
            status.textContent = 'Copy the selected text.';
          }
        });
      });
    </script>
  </body>
</html>
