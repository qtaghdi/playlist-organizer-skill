---
import gemDocument from '../../../integrations/gemini-gem.md?raw';
import '../site.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const repository = 'https://github.com/qtaghdi/playlist-organizer-skill';
const zip = `${repository}/releases/latest/download/playlist-organizer.zip`;
const references = `${repository}/blob/main/skills/playlist-organizer/references`;
const gemInstructions = gemDocument.split('\n---\n')[1].trim();
const installCommand = (agent: string) =>
  `npx --yes skills add qtaghdi/playlist-organizer-skill --skill playlist-organizer -a ${agent} -g -y`;
const hosts = [
  { name: 'Codex', agent: 'codex', invocation: '$playlist-organizer' },
  { name: 'Claude Code', agent: 'claude-code', invocation: '/playlist-organizer' },
  { name: 'Gemini CLI', agent: 'gemini-cli', invocation: 'Playlist Organizer로 이 플리를 정리해줘.' },
  { name: 'GitHub Copilot', agent: 'github-copilot', invocation: 'Playlist Organizer로 이 플리를 정리해줘.' },
  { name: 'Cursor', agent: 'cursor', invocation: 'Playlist Organizer로 이 플리를 정리해줘.' },
  { name: 'OpenCode', agent: 'opencode', invocation: '@playlist-organizer' },
];
const tracks = [
  ['유리 골목', 'Naru Field', '3:42'],
  ['늦은 버스', 'Mio Lane', '4:06'],
  ['물결 위로', 'Yeo June', '3:18'],
  ['한 칸의 불빛', 'Sola Room', '3:54'],
  ['서늘한 공기', 'Naru Field', '4:20'],
  ['새벽의 끝', 'Oru Coast', '3:37'],
];
const services = [
  { name: 'Apple Music', ref: 'apple-music', data: 'Music XML', result: '파일 정리 · macOS 실계정 편집 확인¹' },
  { name: 'Spotify', ref: 'spotify', data: '보관함 JSON, 재생 기록', result: '파일 변환 확인' },
  { name: 'YouTube Music', ref: 'youtube-music', data: 'Takeout CSV', result: '파일 변환 확인' },
  { name: 'M3U / M3U8', ref: 'm3u', data: '로컬 플레이리스트', result: '파일 읽기·다시 저장 확인' },
  { name: 'Last.fm / ListenBrainz', ref: 'history', data: '재생 기록', result: '기록을 곡 목록에 합치기' },
  { name: '기타 음악 앱', ref: 'portable-inputs', data: '곡 목록, CSV', result: '정리안과 새 곡 순서' },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="음악 앱의 플레이리스트를 정리하고, 한 줄 메모로 다음 곡 순서를 다듬는 오픈소스 AI 스킬." />
    <meta name="theme-color" content="#f8f5ee" />
    <link rel="icon" href={`${base}icon.png`} type="image/png" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <title>Playlist Organizer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로</a>
    <header class="masthead wrap">
      <a class="brand" href={base}>
        <img src={`${base}icon.png`} width="32" height="32" alt="" />
        <span>Playlist Organizer</span>
      </a>
      <nav aria-label="주 메뉴">
        <a href="#support">지원 앱</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <div class="hero-copy">
          <h1 id="title">듣던 플리,<br /><span>원하는 흐름으로.</span></h1>
          <p>자주 듣는 곡을 모으고, 곡 사이의 흐름을 다듬어요. 듣다가 남긴 한 줄 메모는 다음 정리에 반영돼요.</p>
          <a class="button main-button" href="#install">스킬 설치하기</a>
        </div>

        <div class="example" id="example" aria-labelledby="example-title">
          <div class="example-header">
            <div>
              <p class="caption">플레이리스트 예시</p>
              <h2 id="example-title">심야 산책</h2>
            </div>
            <label class="switch" hidden>
              <input type="checkbox" id="apply-note" />
              <span class="switch-track" aria-hidden="true"></span>
              <span>메모 반영</span>
            </label>
          </div>
          <ol class="tracks">
            {tracks.map(([title, artist, length], index) => (
              <li data-track={index}>
                <span class="sequence" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="track-name"><strong>{title}</strong><small>{artist}</small></span>
                <span class="duration">{length}</span>
              </li>
            ))}
          </ol>
          <div class="example-note">
            <span>듣고 남긴 메모</span>
            <p>‘늦은 버스’ 바로 다음에 ‘서늘한 공기’가 좋았어.</p>
          </div>
          <p class="visually-hidden" id="example-status" role="status"></p>
        </div>
      </section>

      <section class="install wrap" id="install" aria-labelledby="install-title">
        <div class="section-intro">
          <h2 id="install-title">스킬 설치</h2>
          <p>쓰는 AI 앱을 고르세요.</p>
        </div>
        <div class="installer">
          <label for="host" hidden>AI 앱</label>
          <select id="host" hidden>
            {hosts.map(({ name, agent }) => <option value={agent}>{name}</option>)}
            <option value="claude">Claude 웹·데스크톱</option>
            <option value="gemini">Gemini 웹</option>
          </select>

          {hosts.map(({ name, agent, invocation }) => (
            <div class="setup" data-setup={agent} hidden={agent !== 'codex'}>
              <p>터미널에서 실행하세요. Node.js와 npm이 필요해요.</p>
              <div class="snippet">
                <pre><code>{installCommand(agent)}</code></pre>
                <button type="button" data-copy hidden aria-label={`${name} 설치 명령 복사`}>복사</button>
              </div>
              <p>설치 후 <kbd>{invocation}</kbd>로 시작하세요. 파일 변환에는 Python 3.9 이상이 필요해요.</p>
            </div>
          ))}

          <div class="setup" data-setup="claude" hidden>
            <p>코드 실행을 켠 후 <strong>Customize → Skills</strong>에서 ZIP을 올리세요.</p>
            <a class="button secondary-button" href={zip}>ZIP 받기</a>
            <a class="setup-help" href="https://support.claude.com/en/articles/12512180-use-skills-in-claude">Claude 설치 안내</a>
          </div>
          <div class="setup" data-setup="gemini" hidden>
            <p>Gemini에서 새 Gem을 만들고 아래 지침을 붙여 넣으세요. 곡 목록이나 CSV를 첨부해 시작할 수 있어요.</p>
            <div class="snippet gem">
              <textarea readonly aria-label="Gemini Gem 지침">{gemInstructions}</textarea>
              <button type="button" data-copy hidden aria-label="Gemini Gem 지침 복사">복사</button>
            </div>
            <a class="setup-help" href="https://support.google.com/gemini/answer/15146780">Gem 만들기 안내</a>
          </div>

          <p id="copy-status" class="copy-status" role="status"></p>
          <div class="install-links">
            <a href={zip}>수동 설치용 ZIP</a>
            <a href={`${repository}#install`}>설치 문서</a>
          </div>
        </div>
      </section>

      <section class="support wrap" id="support" aria-labelledby="support-title">
        <h2 id="support-title">음악 앱 지원</h2>
        <p>음악 앱 연결 없이도 내보낸 파일로 시작할 수 있어요.</p>
        <table>
          <caption class="visually-hidden">앱별 입력과 작업 범위</caption>
          <thead><tr><th scope="col">서비스</th><th scope="col">가져오는 자료</th><th scope="col">작업 범위</th></tr></thead>
          <tbody>
            {services.map(({ name, ref, data, result }) => (
              <tr>
                <th scope="row"><a href={`${references}/${ref}.md`}>{name}</a></th>
                <td>{data}</td><td>{result}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="support-note">¹ Apple Music에서 버전 교체와 즐겨찾기 이관을 확인했어요. 대량 순서 변경은 기기 간 동기화 결과를 따로 확인해야 해요.</p>
        <p class="support-note">Spotify와 YouTube Music 실계정 편집은 아직 확인 전이에요. 오래 안 들은 곡은 재생 기록이 있을 때만 판단해요.</p>
      </section>
    </main>

    <footer class="footer wrap">
      <a class="brand" href={base}>
        <img src={`${base}icon.png`} width="26" height="26" alt="" />
        <span>Playlist Organizer</span>
      </a>
      <a href={`${repository}/blob/main/LICENSE`}>MIT License</a>
    </footer>

    <script>
      const noteToggle = document.querySelector<HTMLInputElement>('#apply-note');
      const example = document.querySelector<HTMLElement>('#example');
      if (noteToggle && example) {
        const list = example.querySelector('ol')!;
        const rows = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
        const notedOrder = [0, 1, 4, 2, 3, 5].map((index) => rows[index]);
        const status = example.querySelector('#example-status')!;
        noteToggle.closest('label')!.hidden = false;
        noteToggle.addEventListener('change', () => {
          const order = noteToggle.checked ? notedOrder : rows;
          order.forEach((row, index) => {
            row.querySelector('.sequence')!.textContent = String(index + 1).padStart(2, '0');
            list.append(row);
          });
          example.classList.toggle('note-applied', noteToggle.checked);
          status.textContent = noteToggle.checked
            ? '서늘한 공기를 늦은 버스 다음으로 옮겼어요.'
            : '처음 곡 순서로 돌아왔어요.';
        });
      }

      const host = document.querySelector<HTMLSelectElement>('#host')!;
      const panels = document.querySelectorAll<HTMLElement>('[data-setup]');
      const copyStatus = document.querySelector('#copy-status')!;
      const showSetup = () => {
        panels.forEach((panel) => { panel.hidden = panel.dataset.setup !== host.value; });
        copyStatus.textContent = '';
      };
      host.labels?.[0]?.removeAttribute('hidden');
      host.hidden = false;
      showSetup();
      host.addEventListener('change', showSetup);

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.hidden = false;
        button.addEventListener('click', async () => {
          const snippet = button.closest('.snippet')!;
          const field = snippet.querySelector('textarea');
          const command = snippet.querySelector('code');
          const content = field?.value ?? command?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(content);
            if (!button.closest<HTMLElement>('[data-setup]')?.hidden) {
              copyStatus.textContent = '복사했어요.';
            }
          } catch {
            if (field) {
              field.focus();
              field.select();
            } else if (command) {
              const range = document.createRange();
              range.selectNodeContents(command);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
            copyStatus.textContent = '자동 복사가 안 되면 선택한 내용을 복사하세요.';
          }
        });
      });
    </script>
  </body>
</html>
